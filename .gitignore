# ── Security (NEVER COMMIT SECRETS) ──
.env
.env.*
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──
venv/
.venv/
env/
ENV/

# ── Tool Caches ──
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ── IDE & OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Data (Too large for git) ──
/data/
*.csv
*.dat
*.parquet

# ── Generated Plots & Logs ──
plots/
reports/*.png
*.log

# ── Jupyter ──
.ipynb_checkpoints/

# ── Note on Models ──
# Typically, *.pkl files are ignored and managed via DVC or S3.
# However, we are tracking the `model/` directory here so that 
# Render/Streamlit can easily load the model during deployment.
# If the model gets too large (>50MB), uncomment the line below:
# model/*.pkl
